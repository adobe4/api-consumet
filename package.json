{
  "name": "autoreel",
  "version": "0.1.0",
  "description": "AutoReel — mobile (Android) app that assembles a synced portrait video from a voiceover, ordered visuals, and AI timecode instructions, with live preview and a custom transition designer.",
  "license": "MIT",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "prebuild": "expo prebuild --platform android --no-install",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@shopify/react-native-skia": "1.5.10",
    "expo": "~52.0.11",
    "expo-av": "~15.0.1",
    "expo-document-picker": "~13.0.1",
    "expo-file-system": "~18.0.4",
    "expo-image-picker": "~16.0.3",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "typescript": "~5.7.2",
    "vitest": "^2.1.8"
  },
  "private": true
}
